# Copy to .env in the repository root. Keep credentials on the backend only.
# Safe default: change to octoprint when connecting real hardware.
PRINTER_TYPE=mock
OCTOPRINT_URL=http://<pi-address>
OCTOPRINT_API_KEY=
SNAPSHOT_URL=http://<pi-address>/webcam/?action=snapshot
STREAM_URL=http://<pi-address>/webcam/?action=stream
# URL the managed local vision process uses to publish to this backend.
# VISION_BACKEND_URL=http://127.0.0.1:8000
DISCORD_WEBHOOK_URL=
# Match the hardware library's cold-nozzle resume guard.
RESUME_MIN_TEMP_C=180
# Optional additional dashboard origins (comma separated); localhost:5173 is built in.
# CORS_ORIGINS=http://<dashboard-host>:5173
# Optional location for the persistent SQLite database.
# INCIDENT_DB_PATH=/path/to/print_guardian.db
