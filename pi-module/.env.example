# Safe local default: no hardware requests. Set MOCK=0 explicitly for real hardware.
MOCK=1
OCTO_URL=http://localhost
OCTO_KEY=
HTTP_TIMEOUT=5
UPLOAD_TIMEOUT=120
SNAPSHOT_URL=http://localhost:8080/?action=snapshot
STREAM_URL=http://localhost:8080/?action=stream
REPLAY_DIR=replay
RESUME_MIN_TEMP_C=180
# Health thresholds are optional; defaults are documented in hardware/config.py.
